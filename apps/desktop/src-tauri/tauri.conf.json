{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenFlow",
  "version": "0.1.0",
  "identifier": "dev.openflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenFlow",
        "width": 900,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "publisher": "OpenFlow",
    "category": "Productivity",
    "shortDescription": "Local voice dictation for any app",
    "longDescription": "Fully local, open-source voice dictation. Push-to-talk into any application with on-device speech recognition and local LLM cleanup via Ollama. No cloud, no telemetry.",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false
    }
  }
}
